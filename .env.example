# Copy to .env and fill in. .env is git-ignored; set the same values in the
# Vercel project env (Production + Preview) for deployed builds.

# Flexi chatbot — required for /api/flexi to work. A real Anthropic API key
# (console.anthropic.com), not a Claude.ai subscription. Without it the route
# returns 503 and the widget shows an "unavailable" message.
ANTHROPIC_API_KEY=

# Slack Incoming Webhook — optional. Powers the "prospect opened their page"
# ping (/api/notify-view) and the Flexi transcript post. Unset = those silently
# no-op. Create one at api.slack.com/apps → Incoming Webhooks.
SLACK_WEBHOOK_URL=
