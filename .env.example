# Copy to .env and fill in. .env is git-ignored; set the same values in the
# Vercel project env (Production + Preview) for deployed builds.

# Flexi chatbot — required for /api/flexi to work. A real Anthropic API key
# (console.anthropic.com), not a Claude.ai subscription. Without it the route
# returns 503 and the widget shows an "unavailable" message.
ANTHROPIC_API_KEY=

# Slack — optional. Powers the "prospect opened their page" ping
# (/api/notify-view) and the Flexi transcript post. All unset = silent no-op.
#
# For ONE THREAD PER PROSPECT PAGE (page view = thread root, every Q&A = a reply):
#   SLACK_BOT_TOKEN   xoxb-… — bot needs chat:write (+ chat:write.public to post
#                     to a public channel without being invited)
#   SLACK_CHANNEL_ID  C… — the target channel
#   KV_REST_API_URL / KV_REST_API_TOKEN — an Upstash Redis / Vercel KV store that
#     remembers slug -> thread id. UPSTASH_REDIS_REST_URL / _TOKEN also accepted.
#     Add the Upstash integration in the Vercel dashboard (Storage) and it sets
#     these for you; `vercel env pull` to get them locally.
#
# Without the bot token + thread store it falls back to SLACK_WEBHOOK_URL
# (classic Incoming Webhook) and posts every message flat, no threading.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
KV_REST_API_URL=
KV_REST_API_TOKEN=
SLACK_WEBHOOK_URL=

# Optional — overrides the prod URL used in Slack message links.
NEXT_PUBLIC_SITE_URL=
